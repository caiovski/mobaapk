{
  "expo": {
    "name": "Agropet Lambari",
    "slug": "agropet-cliente",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.agropet.cliente"
    },
    "android": {
      "package": "com.agropet.cliente",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#e96310"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-secure-store",
      "expo-sqlite",
      "expo-location",
      "expo-image-picker",
      "expo-notifications",
      [
        "@sentry/react-native/expo",
        {
          "url": "https://sentry.io/",
          "project": "react-native",
          "organization": "caiovski"
        }
      ],
      "expo-localization"
    ],
    "extra": {
      "eas": {
        "projectId": "6cb70e8d-d12c-4c75-8d0b-d0c818f76a7a"
      }
    },
    "updates": {
      "url": "https://u.expo.dev/6cb70e8d-d12c-4c75-8d0b-d0c818f76a7a"
    },
    "runtimeVersion": {
      "policy": "appVersion"
    }
  }
}
